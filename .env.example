# Copy to .env and fill in:  cp .env.example .env
# docker-compose.yml overrides the host/URL/path values marked [compose] with
# in-network addresses, so those only matter when running bot.py outside Docker.

# ── Gemini ────────────────────────────────────────────────────────────────
# API key from https://aistudio.google.com/apikey. Used by the LangGraph agent
# and by the Gemini component inside the Langflow RAG flow.
GOOGLE_API_KEY=your-gemini-api-key
# Model used by the agent (the RAG flow's model is set in the flow itself).
GEMINI_MODEL=gemini-2.5-flash

# ── Login / database ──────────────────────────────────────────────────────
# Password for the "admin" login and for the admin-only tools.
ADMIN_PASSWORD=change-me
# Demo employees created on the first run only, as user:password pairs.
SEED_USERS=pranshav:change-me-too,alice:change-me-three
# Minutes an account stays locked after 3 failed logins in a row.
LOCKOUT_MINUTES=15
# [compose] SQLite file. In Docker it lives on the hr_data volume.
DB_PATH=hr_database.db

# ── Langflow (RAG pipeline) ───────────────────────────────────────────────
# [compose] Base URL of Langflow.
LANGFLOW_HOST=http://localhost:7860
# Flow ID or endpoint name of the RAG flow (set in langflow/flows/hr_policy_rag.json).
LANGFLOW_FLOW_ID=hr-policy-rag
# Shared secret: Langflow accepts it as its API key, bot.py sends it. Any long random string.
LANGFLOW_API_KEY=generate-a-long-random-string
# Login for the Langflow UI at http://localhost:7860
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=change-me

# ── n8n (self-hosted, action webhooks + Google Sheets logging) ────────────
# [compose] Webhook that receives leave applications.
N8N_LEAVE_WEBHOOK=http://localhost:5678/webhook/apply-leave
# [compose] Webhook that receives audit-log events.
N8N_LOG_WEBHOOK=http://localhost:5678/webhook/log-action
# ID of the Google Sheet to log to (the part of its URL between /d/ and /edit).
# Also needs secrets/google-service-account.json; see docs/google-sheets-setup.md.
# Leave empty to run without Sheets logging.
GOOGLE_SHEET_ID=
